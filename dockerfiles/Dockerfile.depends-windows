# Cross-compile build environment for Lotus on Windows (mingw32).
#
# Produces statically-linked PE binaries via the depends/ system using
# the x86_64-w64-mingw32 and i686-w64-mingw32 toolchains.
#
# Usage (from CI):
#   docker run --rm -v $PWD:/src -w /src lotus-depends-windows \
#     bash -c "make -C depends build-win64 -j$(nproc) && \
#              cmake -GNinja -B build_win64 -DCMAKE_TOOLCHAIN_FILE=cmake/platforms/Win64.cmake && \
#              ninja -C build_win64 lotusd"

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        bsdmainutils \
        build-essential \
        ca-certificates \
        ccache \
        cmake \
        curl \
        faketime \
        g++-mingw-w64-i686 \
        g++-mingw-w64-x86-64 \
        gcc-mingw-w64-i686 \
        gcc-mingw-w64-x86-64 \
        git \
        gperf \
        libtool \
        ninja-build \
        nsis \
        patch \
        pkg-config \
        python3 \
        python3-setuptools \
        unzip \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Force the POSIX threading model on the mingw toolchain (needed by C++11
# std::thread and required by Bitcoin Core descendants).
RUN update-alternatives --set x86_64-w64-mingw32-gcc /usr/bin/x86_64-w64-mingw32-gcc-posix \
    && update-alternatives --set x86_64-w64-mingw32-g++ /usr/bin/x86_64-w64-mingw32-g++-posix \
    && update-alternatives --set i686-w64-mingw32-gcc /usr/bin/i686-w64-mingw32-gcc-posix \
    && update-alternatives --set i686-w64-mingw32-g++ /usr/bin/i686-w64-mingw32-g++-posix

ENV PATH="/usr/lib/ccache:${PATH}"
ENV CCACHE_DIR=/ccache

WORKDIR /src
