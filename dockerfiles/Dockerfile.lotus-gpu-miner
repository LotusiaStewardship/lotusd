# syntax=docker/dockerfile:1.6
#
# Multi-arch cross-build of the NVIDIA / OpenCL Lotus GPU miner.
#
# Targets: linux/amd64 (x86_64 desktops, servers)
#          linux/arm64 (Jetson and aarch64 GPU hosts)
#
# The builder runs on $BUILDPLATFORM (typically amd64 on the runner)
# and cross-compiles the Rust workspace using rustup's stock toolchains
# plus the matching aarch64 GNU cross gcc/g++ when needed. The runtime
# stage is pulled for $TARGETPLATFORM and based on nvidia/cuda so the
# image picks up the correct CUDA / OpenCL ICD for the host arch.

# ------------------------------------------------------------------
# 1. Builder stage — Rust cross-compile
# ------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM rust:slim-bookworm AS builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        libssl-dev \
        ocl-icd-opencl-dev \
        opencl-headers \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Map TARGETPLATFORM → Rust target triple, install the toolchain.
RUN case "$TARGETPLATFORM" in \
        linux/amd64) RUST_TARGET=x86_64-unknown-linux-gnu ;; \
        linux/arm64) RUST_TARGET=aarch64-unknown-linux-gnu ;; \
        *) echo "ERROR: unsupported TARGETPLATFORM '$TARGETPLATFORM'" >&2; exit 1 ;; \
    esac \
    && rustup target add "$RUST_TARGET" \
    && echo "$RUST_TARGET" > /tmp/rust-target

WORKDIR /src
COPY gpuminer /src/gpuminer
WORKDIR /src/gpuminer

RUN RUST_TARGET=$(cat /tmp/rust-target) \
    && case "$RUST_TARGET" in \
        aarch64-unknown-linux-gnu) \
            export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
                   CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
                   CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
                   PKG_CONFIG_ALLOW_CROSS=1 ;; \
       esac \
    && cargo build --release --target "$RUST_TARGET" \
    && mkdir -p /opt/lotus/bin \
    && cp "target/$RUST_TARGET/release/lotus-miner-cli" /opt/lotus/bin/lotus-miner-cli

# ------------------------------------------------------------------
# 2. Runtime stage — NVIDIA CUDA base, target arch
# ------------------------------------------------------------------
FROM --platform=$TARGETPLATFORM nvidia/cuda:12.3.1-base-ubuntu22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        ocl-icd-libopencl1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/OpenCL/vendors /opt/lotus/bin \
    && echo "libnvidia-opencl.so.1" > /etc/OpenCL/vendors/nvidia.icd

COPY --from=builder /opt/lotus/bin/lotus-miner-cli /opt/lotus/bin/lotus-miner-cli
COPY dockerfiles/start-miners.sh /opt/lotus/start-miners.sh

RUN ln -sf /opt/lotus/bin/lotus-miner-cli /opt/lotus/bin/lotus-gpu-miner \
    && chmod +x /opt/lotus/bin/* /opt/lotus/start-miners.sh

ENV PATH="/opt/lotus/bin:${PATH}" \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /opt/lotus
ENTRYPOINT ["/opt/lotus/start-miners.sh"]
