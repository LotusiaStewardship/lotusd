# syntax=docker/dockerfile:1.6
#
# Multi-arch (amd64-only at runtime) build of the AMD / OpenCL Lotus
# GPU miner. ROCm and the Mesa OpenCL ICD only ship binaries for x86_64
# so the runtime stage is restricted to linux/amd64. The Dockerfile is
# still buildx-aware so the matrix workflow can include this image in
# its single-platform pipeline without special-casing the syntax.
#
# Build:
#   docker buildx build --platform linux/amd64 \
#       -f dockerfiles/Dockerfile.lotus-gpu-miner-amd \
#       -t ghcr.io/lotusdevorg/lotus-gpu-miner-amd:<tag> .

# ------------------------------------------------------------------
# 1. Builder stage — Rust build (amd64 only)
# ------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM rust:slim-bookworm AS builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM
ENV DEBIAN_FRONTEND=noninteractive

RUN if [ "$TARGETPLATFORM" != "linux/amd64" ]; then \
        echo "ERROR: Dockerfile.lotus-gpu-miner-amd only supports linux/amd64 (got '$TARGETPLATFORM')" >&2; \
        exit 1; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        libssl-dev \
        ocl-icd-opencl-dev \
        opencl-headers \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY gpuminer /src/gpuminer
WORKDIR /src/gpuminer

RUN cargo build --release \
    && mkdir -p /opt/lotus/bin \
    && cp target/release/lotus-miner-cli /opt/lotus/bin/lotus-miner-cli

# ------------------------------------------------------------------
# 2. Runtime stage — Mesa OpenCL ICD (amd64)
# ------------------------------------------------------------------
FROM --platform=linux/amd64 ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        clinfo \
        libssl3 \
        mesa-opencl-icd \
        ocl-icd-libopencl1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/OpenCL/vendors /opt/lotus/bin

COPY --from=builder /opt/lotus/bin/lotus-miner-cli /opt/lotus/bin/lotus-miner-cli
COPY dockerfiles/start-miners.sh /opt/lotus/start-miners.sh

RUN ln -sf /opt/lotus/bin/lotus-miner-cli /opt/lotus/bin/lotus-gpu-miner \
    && chmod +x /opt/lotus/bin/* /opt/lotus/start-miners.sh

ENV PATH="/opt/lotus/bin:${PATH}"

WORKDIR /opt/lotus
ENTRYPOINT ["/opt/lotus/start-miners.sh"]
