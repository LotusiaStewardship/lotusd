# Build stage -- Debian buster (GCC 8.3, glibc 2.28), the environment TeamCity builds in
# (contrib/teamcity/setup-debian-buster.sh). The depends/ pins are validated against this
# toolchain and contrib/devtools/symbol-check.py expects the glibc surface it produces, so a
# newer base image does not merely build differently -- it fails the release gate.
FROM debian:buster AS builder

ARG HOST_TARGET=x86_64-linux-gnu
ARG TOOLCHAIN_FILE=Linux64.cmake
ARG EXTRA_CMAKE_FLAGS="-DBUILD_BITCOIN_QT=OFF -DENABLE_REDUCE_EXPORTS=ON -DENABLE_STATIC_LIBSTDCXX=ON -DENABLE_GLIBC_BACK_COMPAT=ON"

# depends has its own Qt switch, independent of CMake's BUILD_BITCOIN_QT. Without NO_QT=1
# this image still builds the whole Qt + X11 dependency stack for binaries that never link
# it -- paying every Qt build failure before reaching the daemon and CLI tools it does ship.
ARG NO_QT=1

# Prevent interactive prompts during apt-get install (e.g., tzdata)
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Dependencies come from the tree rather than a hand-maintained list: this is the script
# contrib/teamcity/setup-debian-buster.sh:10 calls. It brings GCC 8, the aarch64 and armhf
# cross toolchains, mingw-w64 (posix variant selected at :119-120), qemu-user-static, nsis,
# wine, and cmake >= 3.16 from buster-backports.
#
# buster is EOL, so its packages live on archive.debian.org and the archive's Release files are
# past Valid-Until. The script runs `apt-get update` at line 90 but only writes the
# Check-Valid-Until override at line 99, so both fixes have to be in place before it is called.
COPY contrib/utils/install-dependencies.sh contrib/utils/llvm.pub /tmp/teamcity-deps/
RUN sed -i \
        -e 's|deb.debian.org|archive.debian.org|g' \
        -e 's|security.debian.org/debian-security|archive.debian.org/debian-security|g' \
        /etc/apt/sources.list \
    && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid-until \
    && /tmp/teamcity-deps/install-dependencies.sh

# Set working directory for the source code
WORKDIR /lotus-source

# Copy the source code
COPY . .

# Build dependencies using the depends system for the target host
RUN make -C depends HOST=$HOST_TARGET NO_QT=$NO_QT JOBS=$(nproc)

# Build all binaries using the depends toolchain, then install and strip debug
# symbols (matching gitian's install-debug target) to minimize binary size.
RUN mkdir build && cd build && \
    cmake -GNinja .. \
      -DBASEPREFIX=/lotus-source/depends \
      -DCMAKE_TOOLCHAIN_FILE=../cmake/platforms/$TOOLCHAIN_FILE \
      $EXTRA_CMAKE_FLAGS \
      -DCLIENT_VERSION_IS_RELEASE=ON \
      -DENABLE_CLANG_TIDY=OFF \
      -DCMAKE_INSTALL_PREFIX=/opt/lotus && \
    ninja install-debug && \
    ninja security-check && \
    ninja symbol-check

# Runtime stage
FROM debian:bookworm-slim

ARG HOST_TARGET
ARG TOOLCHAIN_FILE

# Prevent interactive prompts during apt-get install
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install minimal runtime dependencies (depends system statically links most libs)
RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create directory structure
RUN mkdir -p /opt/lotus/bin /opt/lotus/debug /root/.lotus

# Copy installed (stripped) binaries from builder stage.
# Debug symbols were split out by ninja install-debug.
COPY --from=builder /opt/lotus/bin/lotusd /opt/lotus/bin/
COPY --from=builder /opt/lotus/bin/lotus-cli /opt/lotus/bin/
COPY --from=builder /opt/lotus/bin/lotus-tx /opt/lotus/bin/
COPY --from=builder /opt/lotus/bin/lotus-wallet /opt/lotus/bin/
COPY --from=builder /opt/lotus/bin/lotus-seeder /opt/lotus/bin/

# Copy debug symbol files from builder stage
COPY --from=builder /opt/lotus/bin/lotusd.dbg /opt/lotus/debug/ 2>/dev/null || true
COPY --from=builder /opt/lotus/bin/lotus-cli.dbg /opt/lotus/debug/ 2>/dev/null || true
COPY --from=builder /opt/lotus/bin/lotus-tx.dbg /opt/lotus/debug/ 2>/dev/null || true
COPY --from=builder /opt/lotus/bin/lotus-wallet.dbg /opt/lotus/debug/ 2>/dev/null || true
COPY --from=builder /opt/lotus/bin/lotus-seeder.dbg /opt/lotus/debug/ 2>/dev/null || true

# Set permissions
RUN chmod +x /opt/lotus/bin/*

# Add to PATH
ENV PATH="/opt/lotus/bin:${PATH}"

# Expose commonly used ports
# P2P network
EXPOSE 9333
# RPC interface
EXPOSE 9332
# RPC port from docker-compose
EXPOSE 58525

# Set working directory
WORKDIR /root

# Default command to run the node daemon
ENTRYPOINT ["/opt/lotus/bin/lotusd"]
CMD ["-reindex", "-printtoconsole", "-datadir=/root/.lotus", "-addnode=116.103.232.62", "-addnode=69.234.67.246", "-addnode=146.70.211.96", "-addnode=70.92.25.116", "-addnode=147.135.88.232:10605", "-addnode=147.135.88.233:10605", "-addnode=45.119.84.253:10605", "-addnode=35.184.152.63:10605", "-addnode=147.135.88.232:10605", "-addnode=147.135.88.233:10605", "-addnode=45.119.84.253:10605", "-addnode=35.184.152.63:10605", "-rpcuser=lotus", "-rpcpassword=lkdjflheoiueiiir", "-rpcallowip=10.128.0.0/16", "-rpcbind=0.0.0.0:58525", "-rpcport=58525", "-rpcallowip=127.0.0.1", "-rpcthreads=8", "-disablewallet=0"]
