# syntax=docker/dockerfile:1.6
#
# Multi-arch cross-build of `lotus-qt` (graphical wallet).
# Mirrors Dockerfile.lotusd; see that file's header for design notes.
#
# Note: the Qt toolchain itself is built by depends/ for every target,
# so the resulting binary is portable to the target architecture without
# requiring matching Qt5 packages on the host distro.

# ------------------------------------------------------------------
# 1. Builder stage — depends/ + cmake cross-build (with Qt)
# ------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM ubuntu:22.04 AS builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM
ENV DEBIAN_FRONTEND=noninteractive TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        binutils-aarch64-linux-gnu \
        binutils-arm-linux-gnueabihf \
        binutils-i686-linux-gnu \
        binutils-gold \
        bsdmainutils \
        build-essential \
        ca-certificates \
        ccache \
        cmake \
        curl \
        faketime \
        g++-aarch64-linux-gnu \
        g++-arm-linux-gnueabihf \
        g++-i686-linux-gnu \
        g++-multilib \
        gcc-aarch64-linux-gnu \
        gcc-arm-linux-gnueabihf \
        gcc-i686-linux-gnu \
        gcc-multilib \
        git \
        gperf \
        libtool \
        ninja-build \
        patch \
        pkg-config \
        python3 \
        python3-setuptools \
        unzip \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/lib/ccache:${PATH}" \
    CCACHE_DIR=/ccache

WORKDIR /src
COPY . /src

RUN bash dockerfiles/cross-build.sh lotus-qt

# ------------------------------------------------------------------
# 2. Runtime stage — minimal target-arch image with X11 client libs
# ------------------------------------------------------------------
FROM --platform=$TARGETPLATFORM ubuntu:22.04 AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgcc-s1 \
        libstdc++6 \
        libxcb1 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libdbus-1-3 \
        libfontconfig1 \
        libfreetype6 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/lotus/bin /root/.lotus

COPY --from=builder /opt/lotus/bin/lotus-qt /opt/lotus/bin/lotus-qt
RUN chmod +x /opt/lotus/bin/lotus-qt

ENV PATH="/opt/lotus/bin:${PATH}" \
    QT_X11_NO_MITSHM=1

WORKDIR /root
ENTRYPOINT ["/opt/lotus/bin/lotus-qt"]
CMD ["--help"]
