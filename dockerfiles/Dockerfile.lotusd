# syntax=docker/dockerfile:1.6
#
# Multi-arch cross-build of `lotusd` (the Lotus full node daemon).
#
# The same Dockerfile produces a binary for every Linux architecture in
# the matrix (linux/amd64, linux/arm64, linux/arm/v7). The heavy compile
# is pinned to BUILDPLATFORM (typically amd64 on the CI runner) so we
# avoid running the entire build under QEMU emulation; only the final
# runtime layer is pulled for the target architecture.
#
# Build:
#   docker buildx build \
#       --platform linux/amd64,linux/arm64,linux/arm/v7 \
#       -f dockerfiles/Dockerfile.lotusd \
#       -t ghcr.io/lotusdevorg/lotusd:<tag> .

# ------------------------------------------------------------------
# 1. Builder stage — depends/ + cmake cross-build
# ------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM ubuntu:22.04 AS builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM
ENV DEBIAN_FRONTEND=noninteractive TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        binutils-aarch64-linux-gnu \
        binutils-arm-linux-gnueabihf \
        binutils-gold \
        bsdmainutils \
        build-essential \
        ca-certificates \
        ccache \
        cmake \
        curl \
        faketime \
        g++-aarch64-linux-gnu \
        g++-arm-linux-gnueabihf \
        gcc-aarch64-linux-gnu \
        gcc-arm-linux-gnueabihf \
        git \
        gperf \
        libtool \
        ninja-build \
        patch \
        pkg-config \
        python3 \
        python3-setuptools \
        unzip \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/lib/ccache:${PATH}" \
    CCACHE_DIR=/ccache

WORKDIR /src
COPY . /src

RUN bash dockerfiles/cross-build.sh lotusd

# ------------------------------------------------------------------
# 2. Runtime stage — minimal target-arch image
# ------------------------------------------------------------------
FROM --platform=$TARGETPLATFORM ubuntu:22.04 AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgcc-s1 \
        libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/lotus/bin /root/.lotus

COPY --from=builder /opt/lotus/bin/lotusd /opt/lotus/bin/lotusd
RUN chmod +x /opt/lotus/bin/lotusd

ENV PATH="/opt/lotus/bin:${PATH}"

# P2P, RPC and legacy RPC ports.
EXPOSE 10605 10604 58525

WORKDIR /root
ENTRYPOINT ["/opt/lotus/bin/lotusd"]
CMD ["-printtoconsole", "-datadir=/root/.lotus"]
