# syntax=docker/dockerfile:1.6
#
# Multi-arch cross-build of `lotus-tx` (raw transaction utility).
# Mirrors Dockerfile.lotusd; see that file's header for design notes.

# ------------------------------------------------------------------
# 1. Builder stage — depends/ + cmake cross-build
# ------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM ubuntu:22.04 AS builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM
ENV DEBIAN_FRONTEND=noninteractive TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        binutils-aarch64-linux-gnu \
        binutils-arm-linux-gnueabihf \
        binutils-gold \
        bsdmainutils \
        build-essential \
        ca-certificates \
        ccache \
        cmake \
        curl \
        faketime \
        g++-aarch64-linux-gnu \
        g++-arm-linux-gnueabihf \
        gcc-aarch64-linux-gnu \
        gcc-arm-linux-gnueabihf \
        git \
        gperf \
        libtool \
        ninja-build \
        patch \
        pkg-config \
        python3 \
        python3-setuptools \
        unzip \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/lib/ccache:${PATH}" \
    CCACHE_DIR=/ccache

WORKDIR /src
COPY . /src

RUN bash dockerfiles/cross-build.sh lotus-tx

# ------------------------------------------------------------------
# 2. Runtime stage — minimal target-arch image
# ------------------------------------------------------------------
FROM --platform=$TARGETPLATFORM ubuntu:22.04 AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgcc-s1 \
        libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/lotus/bin

COPY --from=builder /opt/lotus/bin/lotus-tx /opt/lotus/bin/lotus-tx
RUN chmod +x /opt/lotus/bin/lotus-tx

ENV PATH="/opt/lotus/bin:${PATH}"

ENTRYPOINT ["/opt/lotus/bin/lotus-tx"]
CMD ["--help"]
